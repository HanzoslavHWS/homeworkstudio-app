# Server-only credentials. Set real values in Vercel Environment Variables.
APP_LOGIN_PASSWORD=replace-with-a-strong-password
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 S3 API (server-only; never prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
