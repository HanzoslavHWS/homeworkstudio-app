# Server-only credentials. Set real values in Vercel Environment Variables.
APP_LOGIN_PASSWORD=replace-with-a-strong-password
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 S3 API (server-only; never prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# OpenAI Image API (server-only; never prefix with NEXT_PUBLIC_) — Visualization AI environment
# generation. When set, this is the AI provider used (see lib/ai/visualizationAiProvider.server.ts).
OPENAI_API_KEY=
# Optional — defaults to gpt-image-2 (lib/ai/openaiVisualizationAiProvider.server.ts) when unset.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional — defaults to "low" when unset (cheap smoke-testing quality). Switch to "medium"/"high"
# once transport/mask/composite are confirmed working.
OPENAI_IMAGE_QUALITY=low

# Optional — text model for the "E-maily" AI assistant (lib/ai/openaiEmailAiProvider.server.ts).
# Defaults to gpt-4o-mini when unset. Reuses OPENAI_API_KEY above.
OPENAI_TEXT_MODEL=gpt-4o-mini

# HWS SEE (3D prezentace, /see). Reuses SUPABASE_URL / SUPABASE_SECRET_KEY / APP_SESSION_SECRET and
# the R2_* credentials above. Everything below is optional. Server-only — never NEXT_PUBLIC_.
# Dedicated bucket (recommended, e.g. hws-see-prod); empty = the shared R2_BUCKET_NAME under SEE_R2_PREFIX.
SEE_R2_BUCKET_NAME=
SEE_R2_PREFIX=hws-see
# Upload limits in MB (defaults 200 / 50).
SEE_MAX_MODEL_MB=200
SEE_MAX_DOCUMENT_MB=50
# Lifetime of one signed file URL in seconds (30–300, default 60) and of a PIN grant in minutes (default 120).
SEE_FILE_URL_TTL_SECONDS=60
SEE_PIN_GRANT_TTL_MINUTES=120
# signed-url (default: short presigned R2 GET) | stream (bytes go through /api/see/content, re-authorized
# while streaming) | hybrid (documents streamed, models signed).
SEE_FILE_DELIVERY=signed-url
# On unpublish / new PIN / new link / pause the published R2 objects are copied to new opaque keys and the
# old ones deleted, so already issued signed URLs stop working at once. "false" = they expire after the TTL.
SEE_REKEY_ON_REVOKE=true
# Sites allowed to embed /see/embed/* when a presentation uses the default embed policy (CSP
# frame-ancestors, space-separated). Each presentation can narrow it in the editor. Default: 'self' https:
SEE_EMBED_FRAME_ANCESTORS=
# LOCAL DEVELOPMENT ONLY: SEE_BACKEND=local keeps HWS SEE data + files in .see-local/ (ignored in production).
SEE_BACKEND=
