# Server-only credentials. Set real values in Vercel Environment Variables.
APP_LOGIN_PASSWORD=replace-with-a-strong-password
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 S3 API (server-only; never prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# OpenAI Image API (server-only; never prefix with NEXT_PUBLIC_) — Visualization AI environment
# generation. When set, this is the AI provider used (see lib/ai/visualizationAiProvider.server.ts).
OPENAI_API_KEY=
# Optional — defaults to gpt-image-2 (lib/ai/openaiVisualizationAiProvider.server.ts) when unset.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional — defaults to "low" when unset (cheap smoke-testing quality). Switch to "medium"/"high"
# once transport/mask/composite are confirmed working.
OPENAI_IMAGE_QUALITY=low

# Optional — text model for the "E-maily" AI assistant (lib/ai/openaiEmailAiProvider.server.ts).
# Defaults to gpt-4o-mini when unset. Reuses OPENAI_API_KEY above.
OPENAI_TEXT_MODEL=gpt-4o-mini
